# nippou.sh 設定ファイル
# コピーして .env として使用: cp .env.example .env && chmod 600 .env

# GitHub ユーザー名 (未設定の場合 gh auth 済みユーザーを自動取得)
# GH_AUTHOR="your-github-username"

# レポート出力先ディレクトリ (未設定の場合はスクリプトと同階層の logs/)
# REPORT_DIR="$HOME/Documents/nippou"

# zsh 履歴ファイルのパス
# HIST_FILE="$HOME/.zsh_history"

# Slack API トークン (設定すると Slack メッセージも収集)
# SLACK_TOKEN="xoxp-xxxx-xxxx-xxxx"

# Claude Code の入力履歴
# CLAUDE_HISTORY="$HOME/.claude/history.jsonl"

# Claude の最大試行数と初回待機秒数（失敗ごとに待機時間を倍増）
# CLAUDE_MAX_ATTEMPTS=3
# CLAUDE_RETRY_WAIT=15

# ローカル資料の探索先（空白区切り、Git 追跡中の資料は mtime 収集から除外）
# DOC_ROOTS="$HOME/work"

# Claude Code のセッショントランスクリプト
# CLAUDE_PROJECTS_DIR="$HOME/.claude/projects"

# ローカル資料の最大件数と本文行数（空行・frontmatter を除く）
# DOC_MAX_FILES=20
# DOC_MAX_LINES=60

# 月報に渡す PR 本文の最大文字数
# PR_BODY_MAX_CHARS=800
