# nippou.sh 設定ファイル
# コピーして .env として使用: cp .env.example .env && chmod 600 .env

# GitHub ユーザー名 (未設定の場合 gh auth 済みユーザーを自動取得)
# GH_AUTHOR="your-github-username"

# レポート出力先ディレクトリ (未設定の場合はスクリプトと同階層の logs/)
# REPORT_DIR="$HOME/Documents/nippou"

# zsh 履歴ファイルのパス
# HIST_FILE="$HOME/.zsh_history"

# Slack API トークン (設定すると Slack メッセージも収集)
# SLACK_TOKEN="xoxp-xxxx-xxxx-xxxx"

# Claude Code の入力履歴
# CLAUDE_HISTORY="$HOME/.claude/history.jsonl"

# Claude の最大試行数と初回待機秒数（失敗ごとに待機時間を倍増）
# CLAUDE_MAX_ATTEMPTS=3
# CLAUDE_RETRY_WAIT=15

# ローカル資料の探索先（空白区切り、Git 追跡中の資料は mtime 収集から除外）
# DOC_ROOTS="$HOME/work"

# Claude Code のセッショントランスクリプト
# CLAUDE_PROJECTS_DIR="$HOME/.claude/projects"

# ローカル資料の最大件数と本文行数（空行・frontmatter を除く）
# DOC_MAX_FILES=20
# DOC_MAX_LINES=60

# 月報に渡す PR 本文の最大文字数
# PR_BODY_MAX_CHARS=800

# Slack 下書きの作成先（当日・単日・対話実行でのみ作成。送信はしない）
# claude.ai の Slack コネクタへの接続が必要
# SLACK_DRAFT_CHANNEL="C0123456789"

# 対象月の目標シートと本人行の識別値（両方を指定すると参照）
# claude.ai の Google Drive コネクタへの接続が必要
# GOAL_SHEET_URL="https://docs.google.com/spreadsheets/d/スプレッドシートID/edit"
# GOAL_SHEET_PERSON="本人の氏名"
# GOAL_SHEET_READ_TOOLS="mcp__claude_ai_Google_Drive__google_drive_search mcp__claude_ai_Google_Drive__google_drive_fetch"

# Notion の施策一覧（ページまたはデータベースの URL）
# claude.ai の Notion コネクタへの接続が必要
# NOTION_INITIATIVES_URL="https://www.notion.so/ページID"
# NOTION_READ_TOOLS="mcp__claude_ai_Notion__search mcp__claude_ai_Notion__fetch mcp__claude_ai_Notion__notion-search mcp__claude_ai_Notion__notion-fetch"
